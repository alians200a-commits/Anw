{
  "name": "Anw Refact Trial",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Anw Vite App",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "smallcloud.codify"
      ],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  }
}
