{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:content": "tsx tools/content_audit.ts",
    "audit:drugs": "tsx tools/drug_integrity_audit.ts",
    "audit:app": "tsx tools/app_integrity_audit.ts",
    "audit:terms": "tsx tools/term_integrity_audit.ts",
    "audit:security": "node tools/security_audit.mjs",
    "audit:ai-code": "node tools/ai_code_quality_audit.mjs",
    "test": "tsx --test tools/tests/*.test.ts",
    "verify": "npm run lint && npm run audit:security && npm run audit:ai-code && npm run audit:content && npm run audit:drugs && npm run audit:app && npm run audit:terms && npm run test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "8.3.0",
    "motion": "12.23.24"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.28.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
